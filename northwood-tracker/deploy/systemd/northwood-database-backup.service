[Unit]
Description=Northwood Tracker weekly database backup (data-backup/database-backups/ and Google Drive)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=jcyal
WorkingDirectory=/home/jcyal/Documents/northwood-tracker/northwood-tracker
Environment=PATH=/home/jcyal/.config/nvm/versions/node/v24.14.1/bin:/usr/bin:/bin
ExecStart=/home/jcyal/.config/nvm/versions/node/v24.14.1/bin/node --env-file=.env scripts/backup.mjs --database
# MongoDB may still be starting after a boot catch-up run; Google Drive may
# be briefly unreachable.
Restart=on-failure
RestartSec=60
