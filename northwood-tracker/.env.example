# Copy to .env and fill in. Never commit .env.
MONGODB_CONN=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
MONGODB_DB=northwood
AUTH_SECRET=
# The manager account: adds and removes senseis on Dashboard → Senseis.
MANAGER_EMAIL=
# The shared account senseis sign in with, then pick their name.
CENTRAL_EMAIL=
# Password for changing a student's stars in All Students.
STARS_PASSWORD=
